# Generate real random values with scripts/configure.py; never commit .env.
# Production requires HTTPS. For local HTTP development use APP_ENV=development.
APP_ENV=production
APP_IMAGE=ghcr.io/compcj/vibe-domain-agent:latest
HTTP_PORT=8080
HTTPS_PORT=443
SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Local source development only (Compose supplies its own database and Redis URLs):
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_DIR=./data/files
FRONTEND_DIST=./frontend/dist
